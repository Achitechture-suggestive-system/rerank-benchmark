# Use predictable line endings for documentation and ordinary text files.
* text=auto eol=lf

# Preserve exact bytes used by dataset/source checksums and recorded artifacts.
data/*.jsonl -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
benchmark/*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
results/local-*/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
